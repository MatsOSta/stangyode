{
  "name": "stangyode",
  "version": "1.0.0",
  "private": true,
  "description": "The Stangyode company homepage.",
  "scripts": {
    "start": "node server.mjs",
    "build:atlas": "node atlas/scripts/build-atlas.mjs",
    "build:frontier-radar": "node atlas/scripts/render-frontier-briefing.mjs --write",
    "fetch:github-discovery": "node atlas/scripts/fetch-github-discovery.mjs",
    "test:github-discovery": "node --test atlas/scripts/fetch-github-discovery.test.mjs",
    "validate:atlas": "node atlas/scripts/validate-atlas.mjs",
    "validate:frontier-radar": "node atlas/scripts/validate-frontier-radar.mjs",
    "validate:discovery": "node atlas/scripts/validate-discovery.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "check": "node --check public/translations.js && node --check public/app.js && node --check public/ai-engineering/atlas.js && npm run test:github-discovery && npm run validate:i18n && npm run validate:discovery && npm run validate:atlas && npm run validate:frontier-radar"
  }
}
